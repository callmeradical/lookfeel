{
  "name": "lookfeel",
  "version": "0.1.0",
  "description": "Visual evaluation and screenshot testing harness for frontend developers & agentic coding loops",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "lookfeel": "bin/lookfeel.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
