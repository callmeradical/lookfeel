  "keywords": [
    "playwright",
    "screenshots",
    "visual-regression",
    "agentic-coding",
    "ai-agents",
    "evaluation",
    "frontend-testing",
    "ux-review"
  ],
  "author": "Lars Cromley <lars@cromleylabs.com>",
